import { ListView, LineEdit, TextEdit, ComboBox, Palette } from "std-widgets.slint";

export struct Entry {
    label: string,
    method: string,
    sub: string,
    header: bool, // a file row, not a request
}

export struct KV {
    key: string,
    value: string,
}

// One line of the response body, split for colouring.
export struct Line {
    key: string, // indentation plus JSON key, may be empty
    value: string,
    kind: int, // 0 plain, 1 string, 2 number, 3 keyword, 4 punctuation
}

export global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    out property <color> panel: dark ? #0b0a12b0 : #ffffffd9;
    out property <color> raised: dark ? #ffffff08 : #f3f0ff;
    out property <color> hover: dark ? #ffffff10 : #e8e2ff;
    out property <color> line: dark ? #ffffff17 : #d6cfee;
    out property <color> fg: dark ? #e9e6f2 : #17132b;
    out property <color> muted: dark ? #8a8699 : #615c80;
    out property <color> accent: dark ? #b7a6f5 : #5b3fd6;
    out property <color> on-accent: dark ? #0d0b16 : #ffffff;
    out property <color> accent-soft: dark ? #b7a6f51f : #5b3fd61c;

    out property <color> ok: dark ? #3ddc97 : #107a4d;
    out property <color> ok-soft: dark ? #3ddc9726 : #107a4d1f;
    out property <color> bad: dark ? #ff6b81 : #c4263e;
    out property <color> bad-soft: dark ? #ff6b8126 : #c4263e1f;
    out property <color> c-key: dark ? #b7a6f5 : #5b3fd6;
    out property <color> c-string: dark ? #cfd3c2 : #4d5b2b;
    out property <color> c-number: dark ? #e0b089 : #9a4a12;
    out property <color> c-keyword: dark ? #8fb8c9 : #1f6f8b;
    public pure function method(m: string) -> color {
        m == "GET" ? #8fb8c9 : m == "POST" ? #e0b089 : m == "DELETE" ? self.bad : m == "PUT" || m == "PATCH" ? #cfd3c2 : self.muted
    }
}

global Icons {
    out property <string> folder: "M 3 6 L 9 6 L 11 8 L 21 8 L 21 19 L 3 19 Z";
    out property <string> plus: "M 12 5 L 12 19 M 5 12 L 19 12";
    out property <string> search: "M 10 3 A 7 7 0 1 0 10 17 A 7 7 0 1 0 10 3 Z M 15 15 L 21 21";
    out property <string> send: "M 3 11 L 21 3 L 14 21 L 11 13 Z";
    out property <string> copy: "M 8 8 L 20 8 L 20 20 L 8 20 Z M 4 16 L 4 4 L 16 4";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> save: "M 5 4 L 16 4 L 20 8 L 20 20 L 5 20 Z M 8 4 L 8 9 L 15 9 M 8 20 L 8 14 L 16 14 L 16 20";
    out property <string> bolt: "M 14 2 L 5 14 L 11 14 L 9 22 L 19 9 L 13 9 Z";
}

component Icon inherits Path {
    in property <color> tint: Theme.muted;
    in property <bool> filled;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: filled ? tint : transparent;
    stroke: filled ? transparent : tint;
    stroke-width: filled ? 0px : 2px;
}

component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
}

component Btn {
    in property <string> text;
    in property <string> icon;
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <length> h: 36px;
    callback clicked;
    height: h;
    min-width: row.preferred-width;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: label != "" ? label : text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Rectangle {
        border-radius: 4px;
        background: root.primary ? Theme.accent : (ta.has-hover ? Theme.hover : transparent);
        border-width: root.primary ? 0px : 1px;
        border-color: Theme.line;
        opacity: root.enabled ? (ta.pressed ? 0.75 : (root.primary && ta.has-hover ? 0.9 : 1)) : 0.45;
        animate background, opacity { duration: 120ms; }
    }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            filled: root.primary;
            tint: root.primary ? Theme.on-accent : Theme.fg;
            opacity: root.enabled ? 1 : 0.5;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.fg;
            font-weight: 600;
            vertical-alignment: center;
            opacity: root.enabled ? 1 : 0.5;
        }
    }
}

component Tabs {
    in property <[string]> titles;
    in-out property <int> current;
    height: 34px;
    HorizontalLayout {
        alignment: start;
        spacing: 22px;
        for title[i] in root.titles: Rectangle {
            width: tab-label.preferred-width;
            accessible-role: tab;
            accessible-label: title;
            accessible-action-default => { root.current = i; }
            ta := TouchArea {
                clicked => { root.current = i; }
            }
            tab-label := Text {
                y: 4px;
                text: title;
                color: i == root.current || ta.has-hover ? Theme.fg : Theme.muted;
                font-weight: i == root.current ? 600 : 400;
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                x: i == root.current ? 0 : parent.width / 2;
                width: i == root.current ? parent.width : 0;
                background: Theme.accent;
                animate x, width { duration: 160ms; easing: ease-out; }
            }
        }
    }
}

component Cell {
    in-out property <string> text;
    in property <string> hint;
    in property <string> family;
    callback edited;
    horizontal-stretch: 1;
    height: 36px;
    if input.text == "": Text {
        x: 12px;
        text: root.hint;
        color: Theme.muted;
        opacity: 0.6;
        vertical-alignment: center;
        width: parent.width - 24px;
        height: parent.height;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        color: Theme.fg;
        font-family: root.family;
        single-line: true;
        vertical-alignment: center;
        accessible-label: root.hint;
        edited => { root.edited(); }
    }
}

// Editable key/value table used for query parameters and headers.
component Table {
    in-out property <[KV]> rows;
    in property <string> family;
    callback changed;
    callback add;
    callback remove(int);
    Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.raised;
        clip: true;
        VerticalLayout {
            HorizontalLayout {
                height: 34px;
                padding-left: 12px;
                Text {
                    text: @tr("Key");
                    color: Theme.muted;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("Value");
                    color: Theme.muted;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 36px;
                }
            }
            ListView {
                vertical-stretch: 1;
                for r[i] in root.rows: VerticalLayout {
                    Rectangle {
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        Cell {
                            text: r.key;
                            hint: @tr("Key");
                            family: root.family;
                            edited => {
                                root.rows[i].key = self.text;
                                root.changed();
                            }
                        }
                        Rectangle {
                            width: 1px;
                            background: Theme.line;
                        }
                        Cell {
                            text: r.value;
                            hint: @tr("Value");
                            family: root.family;
                            edited => {
                                root.rows[i].value = self.text;
                                root.changed();
                            }
                        }
                        Rectangle {
                            width: 36px;
                            accessible-role: button;
                            accessible-label: @tr("Remove");
                            accessible-action-default => { root.remove(i); }
                            del := TouchArea {
                                clicked => { root.remove(i); }
                            }
                            Icon {
                                width: 14px;
                                height: 14px;
                                commands: Icons.close;
                                tint: del.has-hover ? Theme.bad : Theme.muted;
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            Rectangle {
                height: 36px;
                accessible-role: button;
                accessible-label: @tr("Add row");
                accessible-action-default => { root.add(); }
                adder := TouchArea {
                    clicked => { root.add(); }
                }
                Text {
                    x: 12px;
                    text: "+  " + @tr("Add row");
                    color: adder.has-hover ? Theme.fg : Theme.muted;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }
}

component Seg {
    in property <[string]> titles;
    in-out property <int> current;
    callback changed;
    height: 32px;
    Rectangle {
        border-radius: 4px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
    }
    HorizontalLayout {
        padding: 3px;
        for title[i] in root.titles: Rectangle {
            width: seg-label.preferred-width + 28px;
            border-radius: 4px;
            background: i == root.current ? Theme.accent-soft : transparent;
            accessible-role: tab;
            accessible-label: title;
            accessible-action-default => {
                root.current = i;
                root.changed();
            }
            TouchArea {
                clicked => {
                    root.current = i;
                    root.changed();
                }
            }
            seg-label := Text {
                text: title;
                color: i == root.current ? Theme.fg : Theme.muted;
                font-weight: i == root.current ? 600 : 400;
            }
        }
    }
}

component SideRow {
    in property <Entry> e;
    in property <bool> selected;
    callback clicked;
    height: e.header ? 52px : 36px;
    accessible-role: list-item;
    accessible-label: e.header ? e.label + ", " + e.sub : e.method + " " + e.label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: !root.e.header;
        clicked => { root.clicked(); }
    }
    Rectangle {
        border-radius: 4px;
        background: root.selected ? Theme.accent-soft : (ta.has-hover ? Theme.hover : transparent);
        animate background { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: root.e.header ? 10px : 14px;
        padding-right: 10px;
        spacing: 10px;
        if root.e.header: Icon {
            y: (parent.height - self.height) / 2;
            commands: Icons.folder;
            tint: Theme.accent;
        }
        if root.e.header: VerticalLayout {
            alignment: center;
            Text {
                text: root.e.label;
                color: Theme.fg;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.e.sub;
                color: Theme.muted;
                font-size: 12px;
            }
        }
        if !root.e.header: Text {
            width: 46px;
            text: root.e.method;
            color: Theme.method(root.e.method);
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.e.header: Text {
            text: root.e.label;
            color: root.selected ? Theme.fg : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component Detail {
    in property <string> label;
    in property <string> value;
    in property <string> family;
    HorizontalLayout {
        spacing: 12px;
        Text {
            width: 84px;
            text: root.label;
            color: Theme.muted;
        }
        Text {
            text: root.value == "" ? "-" : root.value;
            color: Theme.fg;
            font-family: root.family;
            wrap: char-wrap;
            horizontal-stretch: 1;
        }
    }
}

export component App inherits Window {
    title: "Snapreq";
    icon: @image-url("../assets/snapreq.svg");
    min-width: 640px;
    min-height: 420px;
    preferred-width: 1440px;
    preferred-height: 860px;
    background: Theme.dark ? #07060b : #efeaff;
    default-font-size: 14px;

    in property <string> project;
    in property <[Entry]> entries;
    in-out property <int> current: -1;
    in property <[string]> envs;
    in-out property <string> env;
    in property <string> mono: "monospace";

    in-out property <string> method: "GET";
    in-out property <string> url;
    in-out property <[KV]> params;
    in-out property <[KV]> headers;
    in-out property <string> body;
    in-out property <bool> dirty;

    in property <bool> busy;
    in property <string> status; // "200 OK"
    in property <int> status-class; // 0 none, 2 ok, 3 redirect, 4 error
    in property <string> duration;
    in property <string> size;
    in property <string> sent;
    in property <string> sent-url;
    in property <[Line]> resp-lines;
    in property <string> resp-text; // formatted body as plain text, for copying
    in property <string> resp-raw; // body exactly as received
    in-out property <int> resp-view; // 0 pretty, 1 raw
    in property <[KV]> resp-headers;
    in property <[string]> snippets;
    in property <[string]> snippet-langs;
    in-out property <int> snippet-lang;
    in-out property <string> note;

    callback select(int);
    callback send;
    callback save;
    callback new-request;
    callback search(string);
    callback url-edited;
    callback params-changed;
    callback add-param;
    callback remove-param(int);
    callback add-header;
    callback remove-header(int);
    callback view-changed;

    property <int> req-tab;
    property <int> resp-tab;
    property <bool> wide: root.width >= 1180px;

    function copy(text: string, what: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        root.note = what;
    }

    function keys(e: KeyEvent) -> EventResult {
        if (e.modifiers.control && e.text == Key.Return) {
            root.send();
            return accept;
        }
        if (e.modifiers.control && e.text == "s") {
            root.save();
            return accept;
        }
        if (e.modifiers.control && e.text == "n") {
            root.new-request();
            return accept;
        }
        if (e.modifiers.control && e.text == "l") {
            url-edit.focus();
            url-edit.select-all();
            return accept;
        }
        if (e.modifiers.control && e.text == "k") {
            search-edit.focus();
            search-edit.select-all();
            return accept;
        }
        return reject;
    }

    clip := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
    }


    // Backdrop: night sky, static stars, three ridge layers drifting at different speeds.
    // The drift is stepped by a timer (12 steps a second) instead of running every frame,
    // and stops completely when `animated` is off.
    in-out property <bool> animated: true;
    property <int> phase;
    Timer {
        interval: 80ms;
        running: Theme.dark && root.animated;
        triggered => { root.phase += 1; }
    }
    if Theme.dark: Rectangle {
        background: @linear-gradient(180deg, #07060b 0%, #0b0915 55%, #121022 100%);
        for star in [
            { x: 0.04, y: 0.06, o: 0.5 }, { x: 0.11, y: 0.31, o: 0.25 }, { x: 0.17, y: 0.12, o: 0.4 },
            { x: 0.24, y: 0.44, o: 0.2 }, { x: 0.29, y: 0.07, o: 0.35 }, { x: 0.36, y: 0.27, o: 0.25 },
            { x: 0.43, y: 0.15, o: 0.5 }, { x: 0.49, y: 0.38, o: 0.2 }, { x: 0.55, y: 0.05, o: 0.3 },
            { x: 0.61, y: 0.22, o: 0.45 }, { x: 0.67, y: 0.47, o: 0.2 }, { x: 0.72, y: 0.10, o: 0.35 },
            { x: 0.78, y: 0.33, o: 0.25 }, { x: 0.84, y: 0.17, o: 0.5 }, { x: 0.89, y: 0.41, o: 0.2 },
            { x: 0.93, y: 0.08, o: 0.4 }, { x: 0.97, y: 0.26, o: 0.3 }, { x: 0.33, y: 0.52, o: 0.2 },
        ]: Rectangle {
            x: star.x * root.width;
            y: star.y * root.height;
            width: 2px;
            height: 2px;
            background: #e9e6f2;
            opacity: star.o;
        }
        // Ridges are vector paths (sharp at any window size). Each one tiles horizontally:
        // two copies side by side scroll left and wrap around.
        for wave in [
            { d: "M 0 200 L 0.0 73.3 L 6.2 74.4 L 12.5 75.2 L 18.8 75.8 L 25.0 76.2 L 31.2 76.2 L 37.5 76.0 L 43.8 75.6 L 50.0 74.9 L 56.2 74.1 L 62.5 73.0 L 68.8 71.8 L 75.0 70.5 L 81.2 69.0 L 87.5 67.4 L 93.8 65.8 L 100.0 64.1 L 106.3 62.4 L 112.5 60.7 L 118.8 58.9 L 125.0 57.1 L 131.2 55.3 L 137.5 53.5 L 143.8 51.7 L 150.0 49.9 L 156.2 48.1 L 162.5 46.3 L 168.8 44.5 L 175.0 42.7 L 181.3 40.9 L 187.5 39.2 L 193.8 37.5 L 200.0 35.9 L 206.3 34.4 L 212.5 33.0 L 218.8 31.8 L 225.0 30.7 L 231.2 29.8 L 237.5 29.1 L 243.8 28.6 L 250.0 28.4 L 256.3 28.4 L 262.5 28.6 L 268.8 29.2 L 275.0 29.9 L 281.2 30.9 L 287.5 32.2 L 293.8 33.5 L 300.0 35.1 L 306.2 36.7 L 312.5 38.4 L 318.8 40.1 L 325.0 41.7 L 331.3 43.3 L 337.5 44.7 L 343.8 46.0 L 350.0 47.0 L 356.2 47.8 L 362.5 48.4 L 368.8 48.7 L 375.0 48.7 L 381.3 48.4 L 387.5 47.9 L 393.8 47.2 L 400.0 46.3 L 406.2 45.3 L 412.5 44.1 L 418.8 43.0 L 425.0 41.9 L 431.2 40.9 L 437.5 40.1 L 443.8 39.5 L 450.0 39.2 L 456.3 39.3 L 462.5 39.7 L 468.8 40.6 L 475.0 42.0 L 481.2 43.8 L 487.5 46.1 L 493.8 48.8 L 500.0 52.0 L 506.2 55.6 L 512.5 59.5 L 518.8 63.7 L 525.0 68.2 L 531.2 72.8 L 537.5 77.5 L 543.8 82.2 L 550.0 86.8 L 556.2 91.3 L 562.5 95.6 L 568.8 99.6 L 575.0 103.2 L 581.2 106.5 L 587.5 109.5 L 593.8 112.0 L 600.0 114.0 L 606.3 115.7 L 612.5 117.0 L 618.8 117.9 L 625.0 118.4 L 631.3 118.7 L 637.5 118.7 L 643.8 118.5 L 650.0 118.2 L 656.2 117.7 L 662.5 117.3 L 668.8 116.8 L 675.0 116.4 L 681.2 116.1 L 687.5 115.8 L 693.8 115.7 L 700.0 115.7 L 706.2 115.8 L 712.5 116.0 L 718.8 116.2 L 725.0 116.5 L 731.3 116.7 L 737.5 117.0 L 743.8 117.1 L 750.0 117.0 L 756.3 116.8 L 762.5 116.3 L 768.8 115.5 L 775.0 114.4 L 781.2 113.0 L 787.5 111.2 L 793.8 109.1 L 800.0 106.6 L 806.2 103.9 L 812.5 100.8 L 818.8 97.4 L 825.0 93.8 L 831.2 90.1 L 837.5 86.3 L 843.8 82.5 L 850.0 78.7 L 856.3 75.0 L 862.5 71.4 L 868.8 68.1 L 875.0 65.1 L 881.3 62.5 L 887.5 60.2 L 893.8 58.3 L 900.0 56.9 L 906.2 55.9 L 912.5 55.4 L 918.8 55.2 L 925.0 55.5 L 931.2 56.2 L 937.5 57.2 L 943.8 58.4 L 950.0 59.9 L 956.2 61.6 L 962.5 63.4 L 968.8 65.2 L 975.0 67.0 L 981.3 68.8 L 987.5 70.5 L 993.8 72.0 L 1000.0 73.3 L 1000 200 Z", top-color: #231f40, foot-color: #1c1935, top: 0.4, speed: 0.6 },
            { d: "M 0 200 L 0.0 127.9 L 6.2 128.0 L 12.5 128.1 L 18.8 128.1 L 25.0 128.2 L 31.2 128.3 L 37.5 128.4 L 43.8 128.4 L 50.0 128.4 L 56.2 128.3 L 62.5 128.2 L 68.8 127.9 L 75.0 127.5 L 81.2 126.9 L 87.5 126.1 L 93.8 125.1 L 100.0 123.8 L 106.3 122.3 L 112.5 120.6 L 118.8 118.6 L 125.0 116.4 L 131.2 114.0 L 137.5 111.3 L 143.8 108.5 L 150.0 105.6 L 156.2 102.5 L 162.5 99.3 L 168.8 96.2 L 175.0 93.1 L 181.3 90.0 L 187.5 87.0 L 193.8 84.2 L 200.0 81.6 L 206.3 79.2 L 212.5 77.1 L 218.8 75.2 L 225.0 73.6 L 231.2 72.3 L 237.5 71.3 L 243.8 70.4 L 250.0 69.9 L 256.3 69.5 L 262.5 69.3 L 268.8 69.3 L 275.0 69.3 L 281.2 69.4 L 287.5 69.6 L 293.8 69.7 L 300.0 69.8 L 306.2 69.8 L 312.5 69.7 L 318.8 69.4 L 325.0 69.1 L 331.3 68.7 L 337.5 68.1 L 343.8 67.5 L 350.0 66.8 L 356.2 66.1 L 362.5 65.3 L 368.8 64.6 L 375.0 64.0 L 381.3 63.4 L 387.5 63.1 L 393.8 62.9 L 400.0 62.9 L 406.2 63.2 L 412.5 63.8 L 418.8 64.6 L 425.0 65.6 L 431.2 67.0 L 437.5 68.5 L 443.8 70.3 L 450.0 72.2 L 456.3 74.2 L 462.5 76.3 L 468.8 78.4 L 475.0 80.4 L 481.2 82.3 L 487.5 84.0 L 493.8 85.5 L 500.0 86.7 L 506.2 87.5 L 512.5 87.9 L 518.8 87.9 L 525.0 87.4 L 531.2 86.6 L 537.5 85.2 L 543.8 83.5 L 550.0 81.3 L 556.2 78.9 L 562.5 76.1 L 568.8 73.1 L 575.0 69.9 L 581.2 66.6 L 587.5 63.4 L 593.8 60.2 L 600.0 57.1 L 606.3 54.3 L 612.5 51.8 L 618.8 49.6 L 625.0 47.9 L 631.3 46.5 L 637.5 45.7 L 643.8 45.4 L 650.0 45.6 L 656.2 46.3 L 662.5 47.5 L 668.8 49.2 L 675.0 51.2 L 681.2 53.7 L 687.5 56.5 L 693.8 59.6 L 700.0 62.9 L 706.2 66.3 L 712.5 69.8 L 718.8 73.4 L 725.0 76.9 L 731.3 80.3 L 737.5 83.6 L 743.8 86.7 L 750.0 89.7 L 756.3 92.4 L 762.5 95.0 L 768.8 97.2 L 775.0 99.3 L 781.2 101.2 L 787.5 102.8 L 793.8 104.3 L 800.0 105.6 L 806.2 106.8 L 812.5 107.9 L 818.8 108.9 L 825.0 109.8 L 831.2 110.8 L 837.5 111.7 L 843.8 112.6 L 850.0 113.6 L 856.3 114.5 L 862.5 115.5 L 868.8 116.5 L 875.0 117.6 L 881.3 118.6 L 887.5 119.6 L 893.8 120.6 L 900.0 121.6 L 906.2 122.6 L 912.5 123.4 L 918.8 124.2 L 925.0 125.0 L 931.2 125.6 L 937.5 126.1 L 943.8 126.6 L 950.0 127.0 L 956.2 127.3 L 962.5 127.5 L 968.8 127.6 L 975.0 127.7 L 981.3 127.8 L 987.5 127.9 L 993.8 127.9 L 1000.0 127.9 L 1000 200 Z", top-color: #18142d, foot-color: #141127, top: 0.5, speed: 1.1 },
            { d: "M 0 200 L 0.0 129.1 L 6.2 130.3 L 12.5 131.5 L 18.8 132.7 L 25.0 133.8 L 31.2 134.8 L 37.5 135.8 L 43.8 136.7 L 50.0 137.5 L 56.2 138.3 L 62.5 139.0 L 68.8 139.6 L 75.0 140.2 L 81.2 140.8 L 87.5 141.3 L 93.8 141.8 L 100.0 142.2 L 106.3 142.6 L 112.5 143.0 L 118.8 143.4 L 125.0 143.8 L 131.2 144.0 L 137.5 144.3 L 143.8 144.4 L 150.0 144.4 L 156.2 144.4 L 162.5 144.1 L 168.8 143.7 L 175.0 143.2 L 181.3 142.4 L 187.5 141.4 L 193.8 140.1 L 200.0 138.7 L 206.3 137.0 L 212.5 135.0 L 218.8 132.9 L 225.0 130.5 L 231.2 128.0 L 237.5 125.4 L 243.8 122.6 L 250.0 119.8 L 256.3 117.1 L 262.5 114.3 L 268.8 111.7 L 275.0 109.3 L 281.2 107.0 L 287.5 105.1 L 293.8 103.4 L 300.0 102.1 L 306.2 101.1 L 312.5 100.6 L 318.8 100.4 L 325.0 100.7 L 331.3 101.4 L 337.5 102.4 L 343.8 103.8 L 350.0 105.5 L 356.2 107.4 L 362.5 109.5 L 368.8 111.8 L 375.0 114.2 L 381.3 116.6 L 387.5 118.9 L 393.8 121.1 L 400.0 123.1 L 406.2 124.8 L 412.5 126.3 L 418.8 127.4 L 425.0 128.2 L 431.2 128.6 L 437.5 128.5 L 443.8 128.1 L 450.0 127.3 L 456.3 126.1 L 462.5 124.5 L 468.8 122.7 L 475.0 120.5 L 481.2 118.2 L 487.5 115.7 L 493.8 113.1 L 500.0 110.5 L 506.2 107.9 L 512.5 105.3 L 518.8 102.8 L 525.0 100.4 L 531.2 98.2 L 537.5 96.3 L 543.8 94.5 L 550.0 92.9 L 556.2 91.5 L 562.5 90.4 L 568.8 89.4 L 575.0 88.6 L 581.2 87.9 L 587.5 87.3 L 593.8 86.8 L 600.0 86.3 L 606.3 85.8 L 612.5 85.2 L 618.8 84.6 L 625.0 83.9 L 631.3 83.2 L 637.5 82.3 L 643.8 81.3 L 650.0 80.1 L 656.2 78.9 L 662.5 77.6 L 668.8 76.3 L 675.0 74.9 L 681.2 73.6 L 687.5 72.2 L 693.8 71.0 L 700.0 69.9 L 706.2 69.0 L 712.5 68.3 L 718.8 67.8 L 725.0 67.5 L 731.3 67.5 L 737.5 67.9 L 743.8 68.5 L 750.0 69.4 L 756.3 70.6 L 762.5 72.1 L 768.8 73.9 L 775.0 75.8 L 781.2 78.0 L 787.5 80.3 L 793.8 82.7 L 800.0 85.2 L 806.2 87.7 L 812.5 90.2 L 818.8 92.7 L 825.0 95.1 L 831.2 97.4 L 837.5 99.6 L 843.8 101.6 L 850.0 103.5 L 856.3 105.2 L 862.5 106.7 L 868.8 108.1 L 875.0 109.3 L 881.3 110.4 L 887.5 111.3 L 893.8 112.2 L 900.0 113.0 L 906.2 113.8 L 912.5 114.5 L 918.8 115.3 L 925.0 116.0 L 931.2 116.8 L 937.5 117.7 L 943.8 118.6 L 950.0 119.5 L 956.2 120.6 L 962.5 121.7 L 968.8 122.8 L 975.0 124.0 L 981.3 125.3 L 987.5 126.5 L 993.8 127.8 L 1000.0 129.1 L 1000 200 Z", top-color: #0d0b19, foot-color: #0b0a14, top: 0.6, speed: 1.9 },
        ]: Rectangle {
            property <length> shift: mod(root.phase * wave.speed * 1px, root.width);
            property <length> strip: root.width * 0.2; // path viewbox is 1000 x 200
            y: wave.top * root.height;
            height: root.height - self.y;
            for copy in [0, 1]: Path {
                x: copy * root.width - parent.shift - copy * 1px;
                y: 0;
                width: root.width + 1px;
                height: parent.strip;
                viewbox-width: 1000;
                viewbox-height: 200;
                commands: wave.d;
                fill: @linear-gradient(180deg, wave.top-color 0%, wave.foot-color 100%);
                stroke-width: 0px;
            }
            Rectangle {
                y: parent.strip - 1px;
                height: parent.height - self.y;
                background: wave.foot-color;
            }
        }
    }

    forward-focus: scope;
    scope := FocusScope {
        key-pressed(e) => { root.keys(e) }

        VerticalLayout {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            padding: 16px;
            spacing: 14px;

            // top bar
            HorizontalLayout {
                height: 40px;
                spacing: 14px;
                HorizontalLayout {
                    width: 246px;
                    spacing: 10px;
                    alignment: start;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        width: 26px;
                        height: 26px;
                        commands: Icons.bolt;
                        filled: true;
                        tint: Theme.accent;
                    }
                    Text {
                        text: "SNAPREQ";
                        color: Theme.fg;
                        font-size: 14px;
                        font-weight: 600;
                        letter-spacing: 4px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    max-width: 520px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: search-edit.has-focus ? Theme.accent : Theme.line;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 10px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            commands: Icons.search;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            if search-edit.text == "": Text {
                                width: parent.width;
                                height: parent.height;
                                text: @tr("Search requests…");
                                color: Theme.muted;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                            search-edit := TextInput {
                                width: parent.width;
                                height: parent.height;
                                color: Theme.fg;
                                single-line: true;
                                vertical-alignment: center;
                                accessible-label: @tr("Search requests…");
                                edited => { root.search(self.text); }
                                key-pressed(e) => { root.keys(e) }
                            }
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: hint.preferred-width + 14px;
                            height: 24px;
                            border-radius: 4px;
                            background: Theme.raised;
                            hint := Text {
                                text: "Ctrl + K";
                                color: Theme.muted;
                                font-size: 12px;
                            }
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.note;
                    color: Theme.muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                if Theme.dark: Btn {
                    y: (parent.height - self.height) / 2;
                    h: 30px;
                    text: root.animated ? @tr("Motion on") : @tr("Motion off");
                    clicked => { root.animated = !root.animated; }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;

                // sidebar (hidden in very narrow windows so the request stays usable)
                if root.width >= 820px: Panel {
                    width: 260px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        HorizontalLayout {
                            height: 36px;
                            padding-left: 6px;
                            spacing: 8px;
                            Text {
                                text: root.project;
                                color: Theme.fg;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Btn {
                                icon: Icons.plus;
                                h: 32px;
                                label: @tr("New request");
                                clicked => { root.new-request(); }
                            }
                        }
                        if root.entries.length == 0: Text {
                            text: @tr("No requests here. Press + to create the first one.");
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for e[i] in root.entries: SideRow {
                                e: e;
                                selected: i == root.current;
                                clicked => { root.select(i); }
                            }
                        }
                        if root.envs.length > 0: Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }
                        if root.envs.length > 0: Text {
                            height: 28px;

                            text: @tr("Environments");
                            color: Theme.muted;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.envs.length > 0: ListView {
                            height: min(root.envs.length * 36px, 150px);
                            for name in root.envs: SideRow {
                                e: { label: name, method: "ENV" };
                                selected: name == root.env;
                                clicked => { root.env = name; }
                            }
                        }
                    }
                }

                // request and response
                VerticalLayout {
                    spacing: 12px;
                    horizontal-stretch: 1;

                    Panel {
                        vertical-stretch: 2;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                height: 44px;
                                ComboBox {
                                    width: 124px;
                                    model: ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"];
                                    current-value <=> root.method;
                                    accessible-label: @tr("Method");
                                    selected => { root.dirty = true; }
                                }
                                url-edit := LineEdit {
                                    text <=> root.url;
                                    placeholder-text: "https://api.example.com/users";
                                    font-family: root.mono;
                                    accessible-label: "URL";
                                    edited => {
                                        root.dirty = true;
                                        root.url-edited();
                                    }
                                    accepted => { root.send(); }
                                    key-pressed(e) => { root.keys(e) }
                                }
                                Btn {
                                    h: 44px;
                                    icon: Icons.send;
                                    text: root.busy ? @tr("Sending…") : @tr("Send");
                                    primary: true;
                                    enabled: !root.busy && root.url != "";
                                    clicked => { root.send(); }
                                }
                                Btn {
                                    h: 44px;
                                    icon: Icons.save;
                                    text: @tr("Save");
                                    enabled: root.dirty && root.current >= 0;
                                    clicked => { root.save(); }
                                }
                            }
                            Tabs {
                                titles: [
                                    @tr("Params") + (root.params.length > 0 ? " (" + root.params.length + ")" : ""),
                                    @tr("Headers") + (root.headers.length > 0 ? " (" + root.headers.length + ")" : ""),
                                    @tr("Body")
                                ];
                                current <=> root.req-tab;
                            }
                            if root.req-tab == 0: Text {
                                text: @tr("Query Params");
                                color: Theme.fg;
                                font-size: 15px;
                                font-weight: 600;
                            }
                            if root.req-tab == 0: Table {
                                vertical-stretch: 1;
                                rows <=> root.params;
                                family: root.mono;
                                changed => {
                                    root.dirty = true;
                                    root.params-changed();
                                }
                                add => { root.add-param(); }
                                remove(i) => { root.remove-param(i); }
                            }
                            if root.req-tab == 1: Table {
                                vertical-stretch: 1;
                                rows <=> root.headers;
                                family: root.mono;
                                changed => { root.dirty = true; }
                                add => { root.add-header(); }
                                remove(i) => { root.remove-header(i); }
                            }
                            if root.req-tab == 2: TextEdit {
                                vertical-stretch: 1;
                                text <=> root.body;
                                font-family: root.mono;
                                wrap: no-wrap;
                                edited => { root.dirty = true; }
                                key-pressed(e) => { root.keys(e) }
                            }
                        }
                    }

                    Panel {
                        vertical-stretch: 3;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 14px;
                                height: 34px;
                                Tabs {
                                    titles: [@tr("Body"), @tr("Headers") + (root.resp-headers.length > 0 ? " (" + root.resp-headers.length + ")" : "")];
                                    current <=> root.resp-tab;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                if root.status != "": Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: pill.preferred-width + 20px;
                                    height: 26px;
                                    border-radius: 3px;
                                    background: root.status-class == 4 ? Theme.bad-soft : Theme.ok-soft;
                                    pill := Text {
                                        text: root.status;
                                        color: root.status-class == 4 ? Theme.bad : Theme.ok;
                                        font-weight: 700;
                                    }
                                }
                                Text {
                                    text: root.duration;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.size;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                }
                                Btn {
                                    y: (parent.height - self.height) / 2;
                                    h: 30px;
                                    icon: Icons.copy;
                                    enabled: root.resp-text != "";
                                    label: @tr("Copy response");
                                    clicked => { root.copy(root.resp-view == 1 ? root.resp-raw : root.resp-text, @tr("Response copied")); }
                                }
                            }
                            if root.resp-tab == 0 && root.status != "": HorizontalLayout {
                                alignment: start;
                                Seg {
                                    titles: [@tr("Pretty"), @tr("Raw")];
                                    current <=> root.resp-view;
                                    changed => { root.view-changed(); }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.raised;
                                clip: true;
                                if root.status == "" && !root.busy: Text {
                                    text: @tr("Press Ctrl+Enter to send the request.");
                                    color: Theme.muted;
                                }
                                // moves only while a request is running, so idle stays at 0 % CPU
                                if root.busy: Rectangle {
                                    y: 0;
                                    height: 1px;
                                    width: parent.width / 4;
                                    x: mod(animation-tick(), 1100ms) / 1100ms * (parent.width + self.width) - self.width;
                                    background: Theme.accent;
                                }
                                if root.resp-tab == 0: ListView {
                                    opacity: root.busy ? 0.25 : 1;
                                    animate opacity { duration: 180ms; }
                                    x: 0;
                                    y: 8px;
                                    width: parent.width;
                                    height: parent.height - 16px;
                                    for l[i] in root.resp-lines: HorizontalLayout {
                                        height: 21px;
                                        spacing: 0px;
                                        alignment: start;
                                        Text {
                                            width: 52px;
                                            text: i + 1;
                                            color: Theme.muted;
                                            opacity: 0.6;
                                            font-family: root.mono;
                                            font-size: 13px;
                                            horizontal-alignment: right;
                                        }
                                        Rectangle {
                                            width: 18px;
                                        }
                                        Text {
                                            text: l.key;
                                            color: Theme.c-key;
                                            font-family: root.mono;
                                            font-size: 13px;
                                        }
                                        Text {
                                            text: l.value;
                                            color: l.kind == 1 ? Theme.c-string : l.kind == 2 ? Theme.c-number : l.kind == 3 ? Theme.c-keyword : l.kind == 4 ? Theme.muted : Theme.fg;
                                            font-family: root.mono;
                                            font-size: 13px;
                                        }
                                    }
                                }
                                if root.resp-tab == 1: ListView {
                                    x: 14px;
                                    y: 8px;
                                    width: parent.width - 28px;
                                    height: parent.height - 16px;
                                    for h in root.resp-headers: HorizontalLayout {
                                        height: 26px;
                                        spacing: 14px;
                                        Text {
                                            width: 240px;
                                            text: h.key;
                                            color: Theme.c-key;
                                            font-family: root.mono;
                                            font-size: 13px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: h.value;
                                            color: Theme.fg;
                                            font-family: root.mono;
                                            font-size: 13px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // details
                if root.wide: Panel {
                    width: 340px;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        alignment: start;
                        Text {
                            text: @tr("Details");
                            color: Theme.fg;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                width: 84px;
                                text: @tr("Method");
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: badge.preferred-width + 16px;
                                height: 22px;
                                border-radius: 4px;
                                background: Theme.accent-soft;
                                badge := Text {
                                    text: root.method;
                                    color: Theme.method(root.method);
                                    font-size: 12px;
                                    font-weight: 700;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        Detail {
                            label: "URL";
                            value: root.sent-url;
                            family: root.mono;
                        }
                        Detail {
                            label: @tr("Sent");
                            value: root.sent;
                        }
                        Detail {
                            label: @tr("Duration");
                            value: root.duration;
                        }
                        Detail {
                            label: @tr("Size");
                            value: root.size;
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }
                        Text {
                            text: @tr("Code snippet");
                            color: Theme.fg;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Seg {
                                titles: root.snippet-langs;
                                current <=> root.snippet-lang;
                            }
                        }
                        Rectangle {
                            height: min(max(snippet.preferred-height + 24px, 80px), 320px);
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.line;
                            background: Theme.raised;
                            clip: true;
                            snippet := Text {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                text: root.snippets[root.snippet-lang];
                                color: Theme.fg;
                                font-family: root.mono;
                                font-size: 12px;
                                wrap: char-wrap;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                        }
                        Text {
                            text: @tr("Quick actions");
                            color: Theme.fg;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Btn {
                            icon: Icons.copy;
                            text: @tr("Copy snippet");
                            enabled: root.snippets.length > 0;
                            clicked => { root.copy(root.snippets[root.snippet-lang], @tr("Snippet copied")); }
                        }
                        Btn {
                            icon: Icons.copy;
                            text: @tr("Copy response");
                            enabled: root.resp-text != "";
                            clicked => { root.copy(root.resp-view == 1 ? root.resp-raw : root.resp-text, @tr("Response copied")); }
                        }
                    }
                }
            }
        }
    }
}
